      <bpmndi:BPMNShape id="DI_Prueba" bpmnElement="Task_Prueba"><omgdc:Bounds x="1015" y="238" width="145" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Espera" bpmnElement="Gateway_Espera" isMarkerVisible="true"><omgdc:Bounds x="1205" y="253" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Informar" bpmnElement="Task_Informar"><omgdc:Bounds x="1320" y="370" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Regresa" bpmnElement="Task_Regresa"><omgdc:Bounds x="1540" y="370" width="175" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Entregar" bpmnElement="Task_Entregar"><omgdc:Bounds x="1320" y="238" width="170" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Salida" bpmnElement="Task_RegistrarSalida"><omgdc:Bounds x="1540" y="238" width="175" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End" bpmnElement="EndEvent_1"><omgdc:Bounds x="1760" y="260" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="E1" bpmnElement="F1"><omgdi:waypoint x="96" y="278"/><omgdi:waypoint x="130" y="278"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="F2"><omgdi:waypoint x="250" y="278"/><omgdi:waypoint x="285" y="278"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="F3"><omgdi:waypoint x="435" y="278"/><omgdi:waypoint x="470" y="278"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="F4"><omgdi:waypoint x="600" y="278"/><omgdi:waypoint x="635" y="278"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="F5"><omgdi:waypoint x="685" y="278"/><omgdi:waypoint x="705" y="278"/><omgdi:waypoint x="705" y="145"/><omgdi:waypoint x="735" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="F6"><omgdi:waypoint x="685" y="278"/><omgdi:waypoint x="735" y="265"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E7" bpmnElement="F7"><omgdi:waypoint x="685" y="278"/><omgdi:waypoint x="705" y="278"/><omgdi:waypoint x="705" y="385"/><omgdi:waypoint x="735" y="385"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E8" bpmnElement="F8"><omgdi:waypoint x="875" y="145"/><omgdi:waypoint x="895" y="145"/><omgdi:waypoint x="895" y="278"/><omgdi:waypoint x="920" y="278"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E9" bpmnElement="F9"><omgdi:waypoint x="875" y="265"/><omgdi:waypoint x="920" y="278"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E10" bpmnElement="F10"><omgdi:waypoint x="875" y="385"/><omgdi:waypoint x="895" y="385"/><omgdi:waypoint x="895" y="278"/><omgdi:waypoint x="920" y="278"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E11" bpmnElement="F11"><omgdi:waypoint x="970" y="278"/><omgdi:waypoint x="1015" y="278"/></bpmndi:BPMNEdge>
