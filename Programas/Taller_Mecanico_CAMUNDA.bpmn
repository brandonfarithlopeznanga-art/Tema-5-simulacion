      <bpmndi:BPMNEdge id="E17" bpmnElement="F17"><omgdi:waypoint x="1490" y="278"/><omgdi:waypoint x="1540" y="278"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E18" bpmnElement="F18"><omgdi:waypoint x="1715" y="278"/><omgdi:waypoint x="1760" y="278"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>